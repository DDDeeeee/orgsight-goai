# 只指向 OrgSight Demo 自己的独立数据库，不得连接外部业务系统或 AgentTeams 数据库。
ORGSIGHT_DATABASE_URL=postgresql://localhost/orgsight_demo

# 本地 MCP HTTP 服务。QwenPaw 在 Docker 内运行时通常通过 host.docker.internal 访问本机。
ORGSIGHT_MCP_HOST=127.0.0.1
ORGSIGHT_MCP_PORT=8787
ORGSIGHT_MCP_EXTERNAL_BASE_URL=http://host.docker.internal:8787

# 本地管理侧网页。网页使用 AgentTeams 为普通 Human `orgsight-web` 创建的
# Matrix 账号登录，然后创建全新的 Source room，直接邀请用户所选的 Team Leader。
# 绝不使用或填写 Matrix 管理员凭证、Manager/Leader/Worker 凭证或 AppService token。
ORGSIGHT_WEB_HOST=127.0.0.1
ORGSIGHT_WEB_PORT=8800
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:28080
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.agentteams.io:28080
ORGSIGHT_WEB_MATRIX_USER=orgsight-web
ORGSIGHT_WEB_MATRIX_PASSWORD=

# 只读已完成案例接口。页面仅从此 AgentTeams Controller 接口读取案例、
# 任务上下文和 result.md；不在 OrgSight 网页中内置业务数据。
AGENTTEAMS_CONTROLLER_URL=http://127.0.0.1:28090
