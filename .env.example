# 只指向 OrgSight Demo 自己的独立数据库，不得连接外部业务系统或 AgentTeams 数据库。
PROFILEMESH_GOAI_DATABASE_URL=postgresql://localhost/profilemesh_goai_demo

# 本地 MCP HTTP 服务。QwenPaw 在 Docker 内运行时通常通过 host.docker.internal 访问本机。
PROFILEMESH_GOAI_MCP_HOST=127.0.0.1
PROFILEMESH_GOAI_MCP_PORT=8787
PROFILEMESH_GOAI_MCP_EXTERNAL_BASE_URL=http://host.docker.internal:8787

# Optional manual task-grant registration token. At runtime, the registered
# Team Leader instead uses its existing AgentTeams gateway credential.
PROFILEMESH_GOAI_GRANT_TOKEN=

# 本地管理侧网页。网页使用 AgentTeams 为普通 Human `profilemesh-web` 创建的
# Matrix 账号登录，然后创建全新的 Source room、邀请 Manager 后发送用户输入。
# 绝不使用或填写 Matrix 管理员凭证、Manager/Leader/Worker 凭证或 AppService token。
PROFILEMESH_WEB_HOST=127.0.0.1
PROFILEMESH_WEB_PORT=8800
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:28080
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.agentteams.io:28080
PROFILEMESH_WEB_MATRIX_USER=profilemesh-web
PROFILEMESH_WEB_MATRIX_PASSWORD=
PROFILEMESH_MANAGER_MATRIX_ID=@manager:matrix-local.agentteams.io:28080

# 只读已完成案例接口。页面仅从此 AgentTeams Controller 接口读取案例、
# 任务上下文和 result.md；不在 ProfileMesh 网页中内置业务数据。
AGENTTEAMS_CONTROLLER_URL=http://127.0.0.1:28090
